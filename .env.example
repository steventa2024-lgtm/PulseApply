# PulseApply — example environment configuration.
#
# NOTHING here is required. PulseApply works without any of these values:
# credentials are normally entered on the Sources / Automation pages and stored
# encrypted with your operating system's keychain (Electron safeStorage).
#
# For development convenience, values set here (copy to .env and export them,
# or set them in your shell) are imported ONCE into the encrypted store at
# startup, only if that credential is not already configured. They are never
# logged and .env files are excluded from packaged builds.

# ---------------------------------------------------------------------------
# Optional provider credentials (all free to obtain)
# ---------------------------------------------------------------------------
# Adzuna — local keyword + location + radius search in 19 countries
#   https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — international aggregator. Keys are issued per regional site.
#   https://jooble.org/api/about
JOOBLE_API_KEY=
# Optional extra regional keys: "gb=KEY,de=KEY"
JOOBLE_REGIONAL_KEYS=

# USAJOBS — U.S. federal jobs. The email must be the one the key was issued to.
#   https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Brave Search API — only used to *discover* employer job boards (optional)
#   https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Telegram bot token from @BotFather (optional)
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Free public sources — no configuration needed
# ---------------------------------------------------------------------------
# Remote OK, Remotive, Arbeitnow, Jobicy, Himalayas, and public employer boards
# on Greenhouse / Lever / Ashby / SmartRecruiters (add employers in the app).

# ---------------------------------------------------------------------------
# Restricted / licensed — cannot be configured here
# ---------------------------------------------------------------------------
# LinkedIn, Indeed, ZipRecruiter, Glassdoor: partner-only APIs. PulseApply opens
# pre-filled searches in your browser instead of scraping them.

# ---------------------------------------------------------------------------
# Development / diagnostics
# ---------------------------------------------------------------------------
# Browser used for application automation (defaults: Playwright Chromium,
# then Chrome, then Edge)
PULSEAPPLY_CHROMIUM_PATH=
# Verbose debug logging (secrets are always redacted)
PULSEAPPLY_DEBUG=0
